# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOMUS_BASE_URL / NOMUS_API_KEY: ERP Nomus (Vendas e Financeiro).
NOMUS_BASE_URL="https://constelha.nomus.com.br/constelha/rest"
NOMUS_API_KEY="MY_NOMUS_API_KEY"

# APONTAMENTO_BASE_URL: app irmão "GFERO - APONTAMENTO PRODUCAO" (aba Produção).
APONTAMENTO_BASE_URL="MY_APONTAMENTO_BASE_URL"

# AUTH_EMAIL / AUTH_PASSWORD: primeiro login da intranet (ver auth.ts).
AUTH_EMAIL="MY_AUTH_EMAIL"
AUTH_PASSWORD="MY_AUTH_PASSWORD"
# Usuários adicionais podem ser numerados sem limite prático:
AUTH_EMAIL_2="SECOND_USER_EMAIL"
AUTH_PASSWORD_2="SECOND_USER_PASSWORD"
# Alternativa: todos os usuários adicionais em um array JSON.
# AUTH_USERS='[{"email":"usuario@empresa.com","password":"senha"}]'
# SESSION_SECRET: string aleatória usada pra assinar o cookie de sessão.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"
